[Unit]
Description=Radio DB internal source cycle (sitemap/rss)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/radio-database
Environment=APP_DIR=/opt/radio-database
Environment=INTERNAL_STATION_LIMIT=12
Environment=INTERNAL_QUERIES_PER_STATION=1
Environment=INTERNAL_MIN_CONFIDENCE=0.35
ExecStart=/opt/radio-database/scripts/run_internal_cycle.sh
User=radio
Group=radio

[Install]
WantedBy=multi-user.target
