[Unit]
Description=Radio DB country discovery cycle (new stations focus)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/radio-database
Environment=APP_DIR=/opt/radio-database
Environment=COUNTRY_DISCOVERY_MAX_QUERIES_PER_RUN=8
Environment=COUNTRY_DISCOVERY_MIN_CONFIDENCE=0.35
Environment=COUNTRY_DISCOVERY_INCLUDE_LINKUP=true
ExecStart=/opt/radio-database/scripts/run_country_discovery_cycle.sh
User=radio
Group=radio

[Install]
WantedBy=multi-user.target
