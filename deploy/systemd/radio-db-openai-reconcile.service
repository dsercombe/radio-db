[Unit]
Description=Radio DB OpenAI daily cost reconciliation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/radio-database
Environment=APP_DIR=/opt/radio-database
ExecStart=/opt/radio-database/scripts/run_openai_cost_reconcile.sh
User=radio
Group=radio

[Install]
WantedBy=multi-user.target
