[Unit]
Description=Radio DB paid enrichment scan cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/radio-database
Environment=APP_DIR=/opt/radio-database
Environment=ENRICHMENT_PAID_SCAN_LIMIT=20
ExecStart=/opt/radio-database/scripts/run_enrichment_paid_cycle.sh
User=radio
Group=radio

[Install]
WantedBy=multi-user.target
