[Unit]
Description=Radio DB real-station verification cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=0
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=50%
WorkingDirectory=/opt/radio-database
Environment=APP_DIR=/opt/radio-database
Environment=VERIFY_BATCH_LIMIT=100
Environment=VERIFY_ONLY_CANDIDATES=true
Environment=VERIFY_FETCH_HOMEPAGES=false
Environment=VERIFY_MAX_PAGE_FETCHES_PER_BATCH=10
Environment=VERIFY_BATCH_SLEEP_SEC=1
Environment=VERIFY_MAX_BATCHES=0
Environment=VERIFY_APPLY=false
Environment=VERIFY_USE_CHECKPOINT=true
Environment=VERIFY_RESET_CHECKPOINT=false
ExecStart=/opt/radio-database/scripts/run_verify_cycle.sh
User=radio
Group=radio

[Install]
WantedBy=multi-user.target
