[Unit]
Description=Radio DB free-source ingest cycle (radio-browser + wikidata)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/radio-database
Environment=APP_DIR=/opt/radio-database
Environment=FREE_INGEST_LIMIT=1200
ExecStart=/opt/radio-database/scripts/run_free_ingest_cycle.sh
User=radio
Group=radio

[Install]
WantedBy=multi-user.target
