[Unit]
Description=Radio DB web dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=radio
Group=radio
WorkingDirectory=/opt/radio-database
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/radio-database/.venv/bin/radio-db dashboard --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
